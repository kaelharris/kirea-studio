# Dependencies
node_modules/

# Build output
dist/
dist-site/
dist-electron/
release/
release-*/
release-build/
release-updater-*/
scrollcraft/builds/
*.tsbuildinfo

# Logs and local artifacts
*.log
npm-debug.log*
app-smoke-*.log
launch_*.txt
verification/
kirea_test_*.png
kirea_*_output.png
.vite/
coverage/

# Agent caches
.agents/
.taste-skill/
.impeccable/

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/

# Local environment and secrets — never commit
.env
.env.*
!.env.example

# Local training tools and environments
# Keep external/training source tracked; only generated weights/data are ignored below.
external/sd-scripts/
external/sd-scripts-venv/

# Temporary generation and training work
temp/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Large local model weights and datasets
/models/
/datasets/
/training-data/
/training-output/
external/training/models/
external/training/datasets/
external/training/data/
external/training/checkpoints/
external/training/output/
external/training/outputs/
external/training/**/*.safetensors
external/training/**/*.ckpt
external/training/**/*.pt
external/training/**/*.pth
external/training/**/*.gguf
external/training/**/*.onnx

# Vendored pixel engines
# SpriteKiln is GPL-3.0 and inspection-only; its source is never committed or packaged.
external/pixel-engines/spritekiln/
# Pixelbolt is MIT; ship only the runtime surface the app imports.
external/pixel-engines/pixelbolt/*
!external/pixel-engines/pixelbolt/src/
!external/pixel-engines/pixelbolt/LICENSE
!external/pixel-engines/pixelbolt/package.json
