# Dependencies
node_modules/

# Build output
dist/
dist-electron/
release/
release-build/
*.tsbuildinfo

# Logs and local artifacts
*.log
npm-debug.log*
app-smoke-*.log
.vite/
coverage/

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/

# Local environment and secrets — never commit
.env
.env.*
!.env.example

# Vendored pixel engines
# SpriteKiln is GPL-3.0 and inspection-only; its source is never committed or packaged.
external/pixel-engines/spritekiln/
# Pixelbolt is MIT; ship only the runtime surface the app imports.
external/pixel-engines/pixelbolt/*
!external/pixel-engines/pixelbolt/src/
!external/pixel-engines/pixelbolt/LICENSE
!external/pixel-engines/pixelbolt/package.json
