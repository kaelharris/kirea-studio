{
  "name": "ai-image-studio-desktop",
  "version": "1.1.1",
  "description": "Kirea Studio â€” Native Windows AI image-generation desktop studio powered by local ComfyUI",
  "main": "dist-electron/main/index.js",
  "author": "kaellabsstudio",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:electron",
    "build:site": "vite build --config vite.site.config.mts",
    "dev:site": "vite --config vite.site.config.mts",
    "preview:site": "vite preview --config vite.site.config.mts",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "pack:win": "npm run build && electron-builder --win --dir",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "better-sqlite3": "^13.1.1",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.34.5",
    "sonner": "^2.0.8",
    "ws": "^8.22.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.14",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
